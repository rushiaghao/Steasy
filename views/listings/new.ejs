<% layout("/layouts/boilerplate") -%>

    <body>
        <div class="form-container">
            <form 
                method="POST" 
                action="/listings" 
                class="form-box needs-validation"
                novalidate
                enctype="multipart/form-data">

                <h3>Create a New Listing</h3><br>

                <div class="form-group">
                    <label for="title">Title:</label>
                    <input id="title" name="listing[title]" placeholder="Enter title" type="text" class="form-control"
                        required />
                    <div class="invalid-feedback">
                        Please enter a title.
                    </div>
                </div>

                <div class="form-group">
                    <label for="description">Description:</label>
                    <textarea id="description" name="listing[description]" placeholder="Enter description..."
                        class="form-control description-box" required></textarea>
                    <div class="invalid-feedback">
                        Please enter a description.
                    </div>
                </div>

                <div class="form-group">
                    <label for="image">Upload Listing Image:</label>
                    <input id="image" name="listing[image]" type="file"
                        class="form-control" multiple />
                </div>

                <div class="row">
                    <div class="form-group col-md-4">
                        <label for="price">Price:</label>
                        <input id="price" name="listing[price]" placeholder="Enter price" type="number"
                            class="form-control" required />
                        <div class="invalid-feedback">
                            Please enter a price.
                        </div>
                    </div>

                    <div class="form-group col-md-8">
                        <label for="country">Country:</label>
                        <input id="country" name="listing[country]" placeholder="Enter country" type="text"
                            class="form-control" required />
                        <div class="invalid-feedback">
                            Please enter a country.
                        </div>
                    </div>
                </div>


                <div class="form-group">
                    <label for="location">Location:</label>
                    <input id="location" name="listing[location]" placeholder="Enter location" type="text"
                        class="form-control" required />
                    <div class="invalid-feedback">
                        Please enter a location.
                    </div>
                </div>

                <button class="btn">Add</button>

            </form>
        </div>
        <br>
    </body>