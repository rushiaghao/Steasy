<% layout("/layouts/boilerplate") -%>
    <body>
        <div class="sub-heading mb-3">
            <h3>All Listings</h3>
        </div>
        <!-- <form method="GET" action="/listings/new">
            <button>Create New Listing</button>
        </form> -->

        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-5">
            <% for(let listing of allListings) { %>
            <a href="/listings/<%= listing._id %>" class="listing-link col">
                <div class="card h-100">
                    <% let imageUrl = Array.isArray(listing.image) && listing.image.length > 0 ? listing.image[0].url : listing.image.url; %>
  
                    <img src="<%= imageUrl %>" class="card-img-tops" alt="listing_image" style="width: 100%; height: 15rem; border-radius: 1rem; object-fit: cover;">
    
                    <div class="card-body">
                        <p class="card-text">
                            <b><%= listing.title %></b>
                            <br />
                            $<%= listing.price.toLocaleString("en-IN") %>  for 1 night
                        </p>
                    </div>
                </div>
            </a>
            <% } %>
        </div>
    </body>
